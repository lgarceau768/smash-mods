Screen {
    layout: vertical;
}

#main {
    height: 1fr;
}

#nav {
    width: 32;
    border-right: solid $panel;
}

#nav ListItem.-section {
    color: $accent;
    background: $boost;
    text-style: bold;
    margin-top: 1;
    padding-top: 1;
}

#content {
    width: 1fr;
    padding: 0 1;
}

#search {
    margin-bottom: 1;
}

#mod-list {
    height: 1fr;
}

#action-panel {
    display: none;
    height: 1fr;
}

#action-desc {
    margin-bottom: 1;
}

#status-line {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

ModDetailModal {
    align: center middle;
}

#detail-panel {
    width: 92%;
    height: 90%;
    border: thick $panel;
    background: $surface;
    padding: 1 2;
}

#detail-body {
    height: 1fr;
    overflow-y: auto;
}

/* Starts hidden/zero-space (no image yet, or none exists for this mod). */
#local-image-container,
#gb-image-container,
#explorer-preview-image {
    display: none;
    width: 100%;
    height: auto;
    max-height: 32;
    margin: 1 0;
}

/* width/height: auto here is load-bearing -- it's what makes Textual ask the
   Image widget's own get_content_width/height for its preferred size at
   all, instead of just stretching it to fill the container's box. That
   preferred size is computed to fit the available space while preserving
   the source image's own aspect ratio (see textual_image's ImageSize) --
   without this rule the image renders squashed/cropped to whatever
   arbitrary box its container happens to have. */
#local-image-container Image,
#gb-image-container Image,
#explorer-preview-image Image {
    width: auto;
    height: auto;
}

#gb-status {
    margin-top: 1;
}

#gb-nav {
    height: 1;
    align: center middle;
}

#gb-nav Button {
    min-width: 10;
}

#gb-caption {
    width: auto;
    margin: 0 2;
}

#layers-select {
    height: 8;
}

#move-row {
    height: 3;
    margin-top: 1;
}

#move-row Select {
    width: 1fr;
}

#move-status {
    margin-bottom: 1;
}

#preview {
    margin: 1 0;
}

LiveOutputScreen {
    align: center middle;
}

#live-panel {
    width: 90%;
    height: 85%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#live-title {
    height: 1;
    margin-bottom: 1;
}

#live-log {
    height: 1fr;
    border: solid $panel;
}

#live-status {
    height: 1;
    color: $text-muted;
    margin: 1 0;
}

ConfirmModal {
    align: center middle;
}

#confirm-panel {
    width: 70;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#confirm-message {
    margin-bottom: 1;
}

#confirm-buttons {
    height: 3;
    align: right middle;
}

#confirm-buttons Button {
    margin-left: 1;
}

#curate-survey-group,
#curate-review-group {
    height: 1fr;
}

#survey-log {
    height: 1fr;
    border: solid $panel;
}

#survey-status {
    height: 1;
    color: $text-muted;
    margin: 1 0;
}

#candidates-select {
    height: 1fr;
    border: solid $panel;
}

#review-summary {
    margin-bottom: 1;
}

#explorer-main {
    height: 1fr;
}

#explorer-list-pane {
    width: 3fr;
    padding: 0 1;
}

#explorer-preview-pane {
    width: 2fr;
    border-left: solid $panel;
    padding: 0 1;
}

#explorer-filters {
    height: 3;
    margin-bottom: 1;
}

#explorer-filters Input {
    width: 2fr;
}

#explorer-filters Select {
    width: 1fr;
}

#explorer-summary {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

#explorer-table {
    height: 1fr;
}

#explorer-preview-text {
    margin-bottom: 1;
}

WelcomeScreen {
    align: center middle;
}

#welcome-panel {
    width: 84;
    height: 80%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#welcome-body {
    height: 1fr;
    overflow-y: auto;
}
